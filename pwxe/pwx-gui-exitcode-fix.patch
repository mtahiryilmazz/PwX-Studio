From d16dc2b0e109b0ce89b37b34293852754357734f Mon Sep 17 00:00:00 2001
From: claude <noreply@anthropic.com>
Date: Thu, 15 Oct 2026 18:53:20 +0000
Subject: [PATCH] Fix GUI exit-code test (Start-Process -Wait) and named-param
 binding in PS7 GUI host

---
 pwxengine/src/PwX.BuildHost.PS7/Program.cs | 16 ++++++++++++++--
 pwxengine/tests/Run-Smoke.ps1              | 17 ++++++++++++++---
 2 files changed, 28 insertions(+), 5 deletions(-)

diff --git a/pwxengine/src/PwX.BuildHost.PS7/Program.cs b/pwxengine/src/PwX.BuildHost.PS7/Program.cs
index 1e7eec8..4e96bf5 100644
--- a/pwxengine/src/PwX.BuildHost.PS7/Program.cs
+++ b/pwxengine/src/PwX.BuildHost.PS7/Program.cs
@@ -104,8 +104,20 @@ namespace PwX.BuildHost
                     // This follows Microsoft's hosting sample: a top-level "exit N"
                     // reaches PSHost.SetShouldExit, while AddArgument binds script params.
                     ps.AddScript(File.ReadAllText(scriptPath));
-                    foreach (string arg in args)
-                        ps.AddArgument(arg);
+                    // pwsh -File gibi: "-Ad deger" adlandirilmis parametre, digerleri konumsal.
+                    // (Hepsini AddArgument ile gecmek "-Message abc -Code 5" gibi cagrilari bozar.)
+                    for (int i = 0; i < args.Length; i++)
+                    {
+                        string a = args[i];
+                        if (a.Length > 1 && a[0] == '-' && char.IsLetter(a[1]))
+                        {
+                            string name = a.Substring(1);
+                            bool nextIsParam = i + 1 < args.Length && args[i + 1].Length > 1 && args[i + 1][0] == '-' && char.IsLetter(args[i + 1][1]);
+                            if (i + 1 < args.Length && !nextIsParam) ps.AddParameter(name, args[++i]);
+                            else ps.AddParameter(name);
+                        }
+                        else ps.AddArgument(a);
+                    }
 
                     try { ps.Invoke(); }
                     catch (RuntimeException ex)
diff --git a/pwxengine/tests/Run-Smoke.ps1 b/pwxengine/tests/Run-Smoke.ps1
index 24933b3..17f1e29 100644
--- a/pwxengine/tests/Run-Smoke.ps1
+++ b/pwxengine/tests/Run-Smoke.ps1
@@ -46,9 +46,20 @@ if ($targets -contains 'PS7') {
     $guiOut = Join-Path $root 'artifacts\test-results\PS7-GUI\hello-gui.exe'
     $guiRes = & $build -Source $sample -Output $guiOut -Target PS7 -Mode Gui -Force
     if ($guiRes.Success -and (Test-Path -LiteralPath $guiRes.OutputPath)) {
-        & $guiRes.OutputPath -Code 17
-        $guiExit = $LASTEXITCODE
-        Add-Row 'PS7-GUI' 'T-GUI-001' 'GUI host betik çıkış kodunu iletir' ($guiExit -eq 17) "beklenen: 17; alınan: $guiExit"
+        # GUI (WinExe) programlari '&' ile cagrildiginda PowerShell beklemez ve $LASTEXITCODE guncellenmez.
+        # Cikis kodu yalnizca Start-Process -Wait -PassThru ile guvenilir olculur.
+        function Get-GuiExit([string]$Exe, [string[]]$ArgList) {
+            $p = Start-Process -FilePath $Exe -ArgumentList $ArgList -Wait -PassThru -WindowStyle Hidden
+            return $p.ExitCode
+        }
+        $guiExit = Get-GuiExit $guiRes.OutputPath @('-Code', '17')
+        Add-Row 'PS7-GUI' 'T-GUI-001' 'GUI host betik çıkış kodunu iletir (17)' ($guiExit -eq 17) "beklenen: 17; alınan: $guiExit"
+        $guiExit = Get-GuiExit $guiRes.OutputPath @('-Code', '1')
+        Add-Row 'PS7-GUI' 'T-GUI-002' 'GUI host çıkış kodu 1' ($guiExit -eq 1) "beklenen: 1; alınan: $guiExit"
+        $guiExit = Get-GuiExit $guiRes.OutputPath @()
+        Add-Row 'PS7-GUI' 'T-GUI-003' 'GUI host normal bitiş 0' ($guiExit -eq 0) "beklenen: 0; alınan: $guiExit"
+        $guiExit = Get-GuiExit $guiRes.OutputPath @('-Message', 'abc', '-Code', '5')
+        Add-Row 'PS7-GUI' 'T-GUI-004' 'GUI host adlandırılmış parametre sırası' ($guiExit -eq 5) "beklenen: 5; alınan: $guiExit"
     }
     else {
         Add-Row 'PS7-GUI' 'T-GUI-001' 'GUI host betik çıkış kodunu iletir' $false 'GUI derlemesi başarısız'
-- 
2.43.0

